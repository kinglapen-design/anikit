dist/

# Rust / Tauri
src-tauri/target/
# ffmpeg sidecar 二进制（tools/fetch-ffmpeg.py 下载，不入库）
src-tauri/binaries/
# ffmpeg dev 库（tools/fetch-ffmpeg.py --dev-lib 下载，阶段四；不入库）
src-tauri/vendor/

# Python
**/.venv/
__pycache__/
*.pyc

# spike 输出（剪贴板数据等，可能含隐私）
spike/**/out/
# spike 工具链与依赖（ffmpeg dev 库、cargo 构建产物，tools/fetch 脚本可重建）
spike/**/vendor/
spike/**/target/
# spike 测试素材（二进制，fetch/生成脚本可重建）
spike/**/testdata/

# 编译期工具链（pip libclang，阶段四 ffmpeg-next 的 bindgen 依赖）
tools/libclang/

# 系统
.DS_Store
Thumbs.db

# 用户维护目录（只读，禁止跟踪）
docs/00_修改与需求/

# 用户临时投放的录屏/参考视频（大文件，非项目资源）
assets/video/
release/

# 设计素材区（213M：图标库 / LOGO 源文件等本地素材区，不入库，2026-09-20 用户定）
design/
# 探针测试素材与截图（临时产物，不入库）
tools/test-assets/
# Obsidian 个人配置（窗口状态等，不入库）
docs/.obsidian/

# 语义离线模型文件与隔离验收产物（prepare-semantic-model.py / 探针可再生）
assets/models/*/models/
assets/models/*/assets/
tools/style-preview/semantic-e2e/
.cache/
